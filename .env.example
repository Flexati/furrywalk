# =============================================================================
# PASSEGGIATA FURBA — Environment Variables
# =============================================================================
# Copia in `.env` e compila con i tuoi valori. NON committare `.env`.
#
# ⚠️  IMPORTANTE: Le variabili server-side (senza EXPO_PUBLIC_) NON vengono
#     incluse nel bundle dell'app. Solo le variabili con prefisso EXPO_PUBLIC_
#     sono accessibili dal client.
# =============================================================================

# --- Supabase (community walks) ---
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Database (PostgreSQL) ---
# Usa il Connection Pooler Supabase (IPv4) per compatibilità con Vercel.
# Porta 6543, user postgres.opeanvqycsdpgusfijve, ?sslmode=require
DATABASE_URL=postgresql://postgres.opeanvqycsdpgusfijve:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- Lemon Squeezy (server-side ONLY — NON usare EXPO_PUBLIC_!) ---
# Queste vengono usate SOLO dal server Vercel. MAI esposte al client.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# --- JWT / Session (OBBLIGATORIO in produzione) ---
# Genera con: openssl rand -base64 64
JWT_SECRET=

# --- OAuth Server (esterno) ---
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# --- App Scheme (deep link) ---
EXPO_PUBLIC_APP_SCHEME=passeggiatafurba

# --- API Backend ---
EXPO_PUBLIC_API_BASE_URL=https://passeggiata-furba.vercel.app

# --- Lemon Squeezy Variant IDs (pubblici, appaiono negli URL checkout) ---
# Pro Ad-Free (monthly / yearly)
EXPO_PUBLIC_LS_PRO_MONTHLY_VARIANT_ID=1628153
EXPO_PUBLIC_LS_PRO_YEARLY_VARIANT_ID=1628200
# Pro Family (monthly / yearly) — non ancora create su LS
EXPO_PUBLIC_LS_FAMILY_MONTHLY_VARIANT_ID=
EXPO_PUBLIC_LS_FAMILY_YEARLY_VARIANT_ID=

# --- Forge API (AI features, opzionale) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Google Play Billing (server-side validation) ---
# Service account JSON su una riga sola: cat key.json | tr -d '\n'
GOOGLE_PLAY_SERVICE_ACCOUNT=
