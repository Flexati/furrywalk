# Copia in `.env` e compila con i tuoi valori. NON committare `.env`.

# --- Supabase (community walks) ---
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.opeanvqycsdpgusfijve.supabase.co:5432/postgres

# --- Lemon Squeezy (API & Store) ---
EXPO_PUBLIC_LEMON_SQUEEZY_API_KEY=
EXPO_PUBLIC_LEMON_SQUEEZY_STORE_ID=
EXPO_PUBLIC_LEMON_SQUEEZY_WEBHOOK_SECRET=

# --- App Scheme (deep link) ---
EXPO_PUBLIC_APP_SCHEME=passeggiatafurba

# --- API Backend ---
EXPO_PUBLIC_API_BASE_URL=https://passeggiata-furba.vercel.app

# --- Lemon Squeezy Variant IDs ---
# Pro Ad-Free (monthly / yearly)
EXPO_PUBLIC_LS_PRO_MONTHLY_VARIANT_ID=
EXPO_PUBLIC_LS_PRO_YEARLY_VARIANT_ID=
# Pro Family (monthly / yearly)
EXPO_PUBLIC_LS_FAMILY_MONTHLY_VARIANT_ID=
EXPO_PUBLIC_LS_FAMILY_YEARLY_VARIANT_ID=
